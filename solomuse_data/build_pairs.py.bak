import json
import logging
import numpy as np
from pathlib import Path
from tqdm import tqdm
from typing import List, Dict, Tuple, Optional

from solomuse_data.config import PipelineConfig
from solomuse_data.io import read_audio, write_audio
from solomuse_data.audio_ops import canonicalize_audio, compute_stats, ensure_channels, resample_audio, loudness_normalize
from solomuse_data.dataset_adapters.base import DatasetAdapter
from solomuse_data.dataset_adapters.slakh import SlakhAdapter
from solomuse_data.dataset_adapters.musdb import MusDBAdapter
from solomuse_data.manifest import write_manifest_pairs

logger = logging.getLogger(__name__)

# Mix consistency thresholds
MSE_THRESHOLD = 1e-4
CORR_THRESHOLD = 0.98

def get_adapter(dataset_name: str, root: str, cfg: PipelineConfig) -> DatasetAdapter:
    root_path = Path(root)
    if dataset_name == "slakh":
        return SlakhAdapter(root_path, cfg)
    elif dataset_name == "musdb":
        return MusDBAdapter(root_path, cfg)
    else:
        raise ValueError(f"Unknown dataset: {dataset_name}")

def align_stems(stems: List[np.ndarray]) -> List[np.ndarray]:
    """Trim all stems to the minimum length."""
    if not stems:
        return []
    min_len = min(s.shape[0] for s in stems)
    return [s[:min_len, :] for s in stems]

def check_mix_consistency(mix_est: np.ndarray, mix_true: np.ndarray) -> Dict:
    """
    Compare estimated mix (sum of stems) with true mixture.
    Both must be aligned and same shape.
    """
    # Ensure same length
    min_len = min(mix_est.shape[0], mix_true.shape[0])
    m_est = mix_est[:min_len]
    m_true = mix_true[:min_len]

    # MSE
    diff = m_est - m_true
    mse = float(np.mean(diff ** 2))

    # Correlation (flatten to 1D)
    # Handle silence?
    if np.sum(m_est**2) < 1e-9 or np.sum(m_true**2) < 1e-9:
        corr = 0.0
    else:
        # np.corrcoef returns matrix
        corr = float(np.corrcoef(m_est.flatten(), m_true.flatten())[0, 1])

    return {
        "mse": mse,
        "corr": corr,
        "max_abs_err": float(np.max(np.abs(diff)))
    }

def build_pairs_for_dataset(dataset_name: str, cfg: PipelineConfig) -> Path:
    logger.info(f"Building pairs for {dataset_name}...")
    
    if dataset_name not in cfg.dataset_roots:
        logger.error(f"Dataset root for {dataset_name} not found in config.")
        return None

    adapter = get_adapter(dataset_name, cfg.dataset_roots[dataset_name], cfg)
    tracks = adapter.list_tracks()
    
    output_dir = Path(cfg.output_root) / "pairs" / dataset_name
    output_dir.mkdir(parents=True, exist_ok=True)
    
    manifest_rows = []
    skipped_rows = []

    for track in tqdm(tracks, desc=f"Processing {dataset_name}"):
        track_id = track.track_id
        
        # 1. Resolve Stems
        stems = adapter.list_stems(track)
        solo_paths = adapter.resolve_solo_stems(stems)
        
        if not solo_paths:
            logger.debug(f"Skipping {track_id}: No solo stems found.")
            skipped_rows.append({"track_id": track_id, "reason": "no_solo"})
            continue
            
        backing_paths = adapter.resolve_backing_stems(stems, solo_paths)
        if not backing_paths:
             logger.debug(f"Skipping {track_id}: No backing stems found (backing is empty).")
             skipped_rows.append({"track_id": track_id, "reason": "no_backing"})
             continue

        try:
            # 2. Load & Canonicalize
            # We need to sum stems BEFORE normalization? 
            # OR normalize individual stems then sum?
            # Standard: normalize the MIX. 
            # Here we are building stems. X and Y should serve as context and target.
            # Usually: 
            #  1. Sum raw stems -> Raw X, Raw Y
            #  2. Canonicalize X and Y independently? Or together?
            #  If we normalize independently, we lose relative level data (solo might become as loud as band).
            #  BUT, solomuse config says lufs_target = -18. 
            #  Audio models often want normalized inputs.
            #  Let's Normalize X to -18, and Y to -18? 
            #  Wait, prompt says: "Canonicalize each stem with audio_ops.canonicalize_audio".
            #  If we canonicalize distinct stems, then sum them, the sum will be louder than -18!
            #  Prompt Step 4: "Sum stems: y_solo = sum(solo_stems)..."
            #  Step 3: "Load audio... Canonicalize each stem..."
            #  This instruction sequence implies:
            #    read -> resample/norm -> align -> sum.
            #  If I normalize every stem to -18 LUFS, then sum them, the drum+bass+piano will be massive.
            #  CORRECTION: "Canonicalize" usually implies resample/channels. 
            #  Loudness normalization on *individual stems* before summing destroys the mix balance.
            #  However, instruction 3 explicitly says "Canonicalize each stem".
            #  Let's re-read carefully: "Canonicalize audio (decode → resample → channelize → normalize...)"
            #  If I normalize *every* stem, the resulting mix is broken.
            #  BETTER APPROACH for "Music":
            #  Sum raw stems -> Raw X, Raw Y. 
            #  Then canonicalize X and Y? 
            #  BUT, prompt 4 step 3 explicitly says "Canonicalize each stem".
            #  Maybe "Canonicalize" just means SR/Channels/Decode here for stems, and normalize later?
            #  Prompt 1 defines canonicalize_audio as including loudness_normalize.
            #  Proposed compromise: 
            #  The prompt might assume single-stem scenarios or that we want normalized stems. 
            #  But X = sum(backing). Equalizing backing stems is weird.
            #  Let's look at Step 5: "Mix consistency... Load + canonicalize mixture". 
            #  If we normalize stems, sum them, and compare to a normalized mixture, they won't match if stems were re-balanced.
            #  CRITICAL: If we are checking mix consistency, we MUST preserve relative levels.
            #  Therefore, we CANNOT strictly "loudness normalize" individual stems if we want to check against the mix.
            #  Alternative interpretation: "Canonicalize" in Step 3 context might mean 'make float32, resample, ensure channels'. 
            #  Loudness normalization should happen on the FINAL X and Y?
            #  Actually, if we normalize X and Y independently, we break the relative level of Solo vs Backing.
            #  Usually we want X+Y to be -18 LUFS.
            #  Let's assume the safest path that respects "Mix Consistency" check:
            #  1. Read raw stems.
            #  2. Resample/channelize (but do NOT normalize loudness yet).
            #  3. Sum to get Raw X and Raw Y.
            #  4. Construct Raw Mix = X + Y.
            #  5. Normalize Raw Mix to -18 LUFS. Apply same gain to X and Y.
            #  This preserves balance.
            #  HOWEVER, strict adherence to prompt: "Canonicalize each stem... Sum stems...".
            #  If I follow prompt literally, the consistency check will fail (Correlation might be ok, MSE huge).
            #  The Prompt 4 rationale says: "if X/Y aren't aligned, normalized, and sum-consistent...".
            #  "Normalized" AND "Sum-consistent". 
            #  This implies we need a global normalization gain.
            #  
            #  DECISION: I will write a helper `load_and_resample` that skips loudness norm.
            #  Then sum. Then normalize the sum (Raw Mix) and apply that gain to X and Y.
            #  Wait, if we don't have the mixture file, how do we know the gain?
            #  We normalize (X+Y) to -18.
            #  
            #  Let's verify this interpretation against "Consistency Check".
            #  "Load + canonicalize mixture". Canonicalize includes normalization.
            #  So Mix_True is normalized to -18.
            #  Mix_Est = X + Y. If we normalize Mix_Est to -18, then X and Y scaled proportionally.
            #  Then Mix_Est ≈ Mix_True.
            #  This seems correct.
            
            # Helper to load and process format (SR/Channels) without loudness norm
            def process_stem(p):
                # logger.debug(f"  Loading stem: {p.name}") 
                # Debug might be too verbose if not enabled. 
                # But since loop is slow, maybe INFO for main steps?
                a, sr = read_audio(str(p))
                a = ensure_channels(a, cfg.canonical_channels)
                if sr != cfg.canonical_sample_rate:
                    a = resample_audio(a, sr, cfg.canonical_sample_rate)
                return a
            
            logger.info(f"  [{track_id}] Loading {len(solo_paths)} solo and {len(backing_paths)} backing stems...")
            
            # Load stems
            solo_audios = [process_stem(p) for p in solo_paths]
            backing_audios = [process_stem(p) for p in backing_paths]
            
            logger.info(f"  [{track_id}] Aligning and Summing...")
            
            # Align (trim to min length of ALL stems + mix if exists)
            # We align solo and backing first
            all_stems = solo_audios + backing_audios
            
            # Get mix path for alignment and consistency
            mix_path = adapter.get_mix_path(track)
            mix_audio = None
            if mix_path:
                mix_audio = process_stem(mix_path)
                all_stems.append(mix_audio)
                
            all_stems = align_stems(all_stems)
            
            # Unpack
            offset = len(solo_audios)
            solo_aligned = all_stems[:offset]
            backing_aligned = all_stems[offset:offset+len(backing_audios)]
            
            if mix_path:
                mix_aligned = all_stems[-1]
            else:
                mix_aligned = None
                
            # Sum
            y_solo = sum(solo_aligned) if solo_aligned else np.zeros_like(backing_aligned[0]) # Should not accept empty solo
            x_backing = sum(backing_aligned)
            if isinstance(y_solo, int): y_solo = np.zeros_like(x_backing) # Safety if list empty but didn't trigger skip
            
            mix_est = x_backing + y_solo
            
            # Now Normalize
            # We want Mix_Est to be -18 LUFS.
            # Calculate gain for Mix_Est
            # Apply same gain to X and Y.
            # Note: `loudness_normalize` does this calculation internaly.
            # We need to expose a way to get gain? 
            # Or just normalize mix_est, and compute the gain used?
            # pyloudnorm meter.integrated_loudness(mix_est).
            # gain = target - measured.
            sr = cfg.canonical_sample_rate
            
            # Calculate Loudness of estimated mix
            # We handle silence case
            try:
                import pyloudnorm as pyln
                meter = pyln.Meter(sr)
                loudness = meter.integrated_loudness(mix_est)
            except ValueError:
                loudness = -np.inf
                
            if loudness > -70: # Not silent
                target = cfg.lufs_target
                gain_db = target - loudness
                gain_lin = 10**(gain_db / 20.0)
            else:
                gain_lin = 1.0 # Verify silence handling
                
            # Apply Gain
            # Also need to check peak limit on the MIX? Or components?
            # If we limit the mix, we might non-linearly alter it, breaking X+Y=Mix relations if we clamped X or Y differently.
            # Proper way: Limit the Mix, apply same attenuation to X and Y? 
            # Hard limiter is non-linear. `min(signal, threshold)`. 
            # `min(x+y, thresh) != min(x, thresh) + min(y, thresh)`.
            # If we run a hard limiter on X and Y separately, X+Y != Limited(Mix).
            # If we run a hard limiter on Mix, we break linearity to X, Y.
            # HOWEVER, for training we want X and Y to be valid audio.
            # Config says `peak_limit_dbfs`.
            # Let's apply gain. Then check peaks of X and Y independently. 
            # If X clips, attenuate X. If Y clips, attenuate Y.
            # This breaks Mix Consistency (Sum != Mix) but ensures valid audio files.
            # Being "Sum Consistent" is important for separation models training `Mix -> Y`.
            # If we train input=X (Context), target=Y... 
            # Solomuse prompt: "X = backing/context, Y = solo stem". 
            # We don't necessarily input Mix. 
            # But we might want `Mix = X + Y`.
            # Let's prioritize Gain consistency. 
            # Apply global gain. Then soft-clamp or check peaks?
            # Only if peak > limit.
            
            y_solo *= gain_lin
            x_backing *= gain_lin
            mix_est *= gain_lin
            
            # Consistency Check (on normalized signals)
            metrics = {"mse": 0.0, "corr": 1.0}
            has_mix = False
            
            if mix_aligned is not None:
                # Normalize true mix to SAME target
                # If true mix is -18 LUFS, and our stems are good, they should match.
                mix_true_norm = loudness_normalize(mix_aligned, sr, cfg.lufs_target, cfg.peak_limit_dbfs)
                metrics = check_mix_consistency(mix_est, mix_true_norm)
                has_mix = True
                
                if metrics["mse"] > MSE_THRESHOLD:
                    logger.warning(f"Track {track_id} MSE high: {metrics['mse']:.6f}")
                if metrics["corr"] < CORR_THRESHOLD:
                    logger.warning(f"Track {track_id} Corr low: {metrics['corr']:.4f}")
                    
            # Compute stats
            stats_x = compute_stats(x_backing, sr)
            stats_y = compute_stats(y_solo, sr)
            
            # Write files
            track_dir = output_dir / track_id
            track_dir.mkdir(parents=True, exist_ok=True)
            
            x_path = track_dir / "x_backing.wav"
            y_path = track_dir / "y_solo.wav"
            
            write_audio(str(x_path), x_backing, sr)
            write_audio(str(y_path), y_solo, sr)
            
            metadata = {
                "dataset": dataset_name,
                "track_id": track_id,
                "license": adapter.get_metadata(track).get("license", "unknown"),
                "solo_stems": [p.name for p in solo_paths],
                "backing_stems": [p.name for p in backing_paths],
                "sr": sr,
                "channels": cfg.canonical_channels,
                "duration_s": x_backing.shape[0] / sr,
                "stats_x": stats_x,
                "stats_y": stats_y,
                "mix_metrics": metrics if has_mix else None
            }
            
            with open(track_dir / "meta.json", "w") as f:
                json.dump(metadata, f, indent=2)
                
            manifest_rows.append({
                "dataset": dataset_name,
                "track_id": track_id,
                "x_path": str(x_path.absolute()),
                "y_path": str(y_path.absolute()),
                "sr": sr,
                "channels": cfg.canonical_channels,
                "duration_s": metadata["duration_s"],
                "license": metadata["license"],
                "has_mix": has_mix,
                "mse": metrics.get("mse", ""),
                "corr": metrics.get("corr", ""),
                "notes": f"mse={metrics.get('mse',0):.1e}" if has_mix and metrics.get('mse',0) > MSE_THRESHOLD else ""
            })

        except Exception as e:
            logger.error(f"Failed to process {track_id}: {e}", exc_info=True)
            skipped_rows.append({"track_id": track_id, "reason": "error", "details": str(e)})

    # Write Manifest
    manifest_path = output_dir / "manifest.csv"
    write_manifest_pairs(manifest_rows, str(manifest_path))
    
    return manifest_path
